# Ledger-as-a-Service (LaaS) environment variables.
# Copy to .env.local for local development. All keys use the LAAS_ prefix.
#
# Run: uvicorn traust_ledger.service.app:create_app --factory --reload

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Storage backend: "file" (JSON on disk) or "db" (PostgreSQL via SQLAlchemy).
LAAS_BACKEND_TYPE=file

# PostgreSQL connection URL. Required when LAAS_BACKEND_TYPE=db.
# LAAS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/laas

# Root directory for file-backend layer JSON files.
LAAS_DATA_DIR=/var/lib/laas/data

# ---------------------------------------------------------------------------
# Identity provider
# ---------------------------------------------------------------------------

# Provider: "oidc" (production). Machine callers use OIDC client-credentials
# or Kubernetes projected service-account tokens.
LAAS_IDENTITY_PROVIDER=oidc

# OIDC — required when LAAS_IDENTITY_PROVIDER=oidc.
# The app refuses to start without LAAS_OIDC_JWKS_URL when provider is oidc.
# LAAS_OIDC_JWKS_URL=https://sso.example.com/realms/your-realm/protocol/openid-connect/certs
# LAAS_OIDC_ISSUER=https://sso.example.com/realms/your-realm
# LAAS_OIDC_AUDIENCE=laas-api
# LAAS_OIDC_IDENTITY_CLAIM=email
# LAAS_OIDC_MACHINE_CLAIM=azp

# Local identity — set this instead of LAAS_TOKEN for local dev without OIDC.
# A self-signed JWT is auto-minted. No external provider required.
# LEDGER_LOCAL_IDENTITY=you@example.com

# ---------------------------------------------------------------------------
# Signing
# ---------------------------------------------------------------------------

# Require Merkle-root signing on layer finalize.
LAAS_SIGNING_REQUIRED=false

# Path to the cosign private key. Required when LAAS_SIGNING_REQUIRED=true.
# LAAS_SIGNING_KEY_PATH=/path/to/cosign.key

# Signing provider: "cosign" (keypair) or "sigstore-oidc".
LAAS_SIGNING_METHOD=cosign

# OIDC identity-based signing (when LAAS_SIGNING_METHOD=sigstore-oidc).
# LAAS_OIDC_ISSUER_URL=https://oauth2.sigstore.dev/auth
# LAAS_OIDC_CLIENT_ID=sigstore

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR.
LAAS_LOG_LEVEL=INFO
