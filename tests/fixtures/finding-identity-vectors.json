{
  "$comment": "Cross-implementation conformance vectors for scripts/finding_identity.py \u2014 the fingerprint IS the platform definition of finding identity (tier-1 auto-confirm). Any port (e.g. Source Code Intelligence internal/pipeline/fingerprint.go) MUST pass every case; regenerate ONLY by running tests/test_finding_identity_vectors.py --regen after a deliberate, versioned identity-semantics change. payload is the exact pre-sha256 string (canon_repo|;-joined sorted canon_paths|primary_cwe).",
  "algorithm": "sha256(canon_repo(repo_url) + '|' + ';'.join(sorted(set(canon_path(p) for p in location paths if p))) + '|' + primary_cwe)",
  "canon_repo": [
    {
      "input": "https://github.com/Org/Repo.git",
      "expected": "https://github.com/org/repo"
    },
    {
      "input": "git@github.com:org/repo.git",
      "expected": "https://github.com/org/repo"
    },
    {
      "input": "ssh://git@gitlab.cee.example.com/group/sub-group/repo/",
      "expected": "https://git@gitlab.cee.example.com/group/sub-group/repo"
    },
    {
      "input": "git://github.com/org/repo",
      "expected": "https://github.com/org/repo"
    },
    {
      "input": "HTTPS://GITHUB.COM/ORG/REPO/",
      "expected": "https://github.com/org/repo"
    },
    {
      "input": "https://gitlab.com/group/sub.group/repo.name_x",
      "expected": "https://gitlab.com/group/sub.group/repo.name_x"
    },
    {
      "input": "not a url at all",
      "expected": "not a url at all"
    },
    {
      "input": "",
      "expected": ""
    },
    {
      "input": null,
      "expected": ""
    }
  ],
  "canon_path": [
    {
      "input": "./pkg/reg.go",
      "expected": "pkg/reg.go"
    },
    {
      "input": "pkg//sub///file.go",
      "expected": "pkg/sub/file.go"
    },
    {
      "input": "pkg\\win\\path.go",
      "expected": "pkg/win/path.go"
    },
    {
      "input": "/abs/lead.go",
      "expected": "abs/lead.go"
    },
    {
      "input": "trail/dir/",
      "expected": "trail/dir"
    },
    {
      "input": "  spaced.go  ",
      "expected": "spaced.go"
    },
    {
      "input": "",
      "expected": ""
    },
    {
      "input": null,
      "expected": ""
    }
  ],
  "fingerprint": [
    {
      "name": "single location, single cwe",
      "repo_url": "https://github.com/Org/Repo.git",
      "finding": {
        "cwes": [
          "CWE-22"
        ],
        "locations": [
          {
            "path": "./pkg/reg.go",
            "lines": [
              42
            ]
          }
        ]
      },
      "payload": "https://github.com/org/repo|pkg/reg.go|CWE-22",
      "expected": "513e74351d52d403b22ca0f7fc93a948bb2ae017f260f0bacb7b8e271ce3bb1f"
    },
    {
      "name": "multiple unsorted duplicate locations sort+dedupe",
      "repo_url": "git@github.com:org/repo.git",
      "finding": {
        "cwes": [
          "CWE-89",
          "CWE-20"
        ],
        "locations": [
          {
            "path": "z/b.go"
          },
          {
            "path": "a/a.go"
          },
          {
            "path": "z//b.go"
          }
        ]
      },
      "payload": "https://github.com/org/repo|a/a.go;z/b.go|CWE-20",
      "expected": "5b4f36d6bbd82b653c8ed57769959e0f62387b6dc9f82e78a7254e517b0c3d08"
    },
    {
      "name": "no cwes falls back to CWE-0",
      "repo_url": "https://github.com/org/repo",
      "finding": {
        "cwes": [],
        "locations": [
          {
            "path": "main.go"
          }
        ]
      },
      "payload": "https://github.com/org/repo|main.go|CWE-0",
      "expected": "ccb849c820fcbe7ed4bec1a2f71198a16c31e2a2e3121e074238e126092e1906"
    },
    {
      "name": "no locations -> empty path segment",
      "repo_url": "https://github.com/org/repo",
      "finding": {
        "cwes": [
          "CWE-1104"
        ],
        "locations": []
      },
      "payload": "https://github.com/org/repo||CWE-1104",
      "expected": "3fe32be3b267791e6209d7fac14e4adb394e929bf1e927236abe28c8389595b1"
    },
    {
      "name": "lowercase cwe uppercased",
      "repo_url": "https://github.com/org/repo",
      "finding": {
        "cwes": [
          " cwe-79 "
        ],
        "locations": [
          {
            "path": "web/tmpl.go"
          }
        ]
      },
      "payload": "https://github.com/org/repo|web/tmpl.go|CWE-79",
      "expected": "7430d18bf0e094883994fc2b2e90c5fa6f7a4b315163844c000b064ac944d6cc"
    },
    {
      "name": "gitlab subgroup + windows path",
      "repo_url": "ssh://git@gitlab.cee.example.com/group/sub-group/repo/",
      "finding": {
        "cwes": [
          "CWE-798"
        ],
        "locations": [
          {
            "path": "cfg\\secrets\\dev.yaml"
          }
        ]
      },
      "payload": "https://git@gitlab.cee.example.com/group/sub-group/repo|cfg/secrets/dev.yaml|CWE-798",
      "expected": "78cf5cbd44746131c108805b086165a9b37b0864ef55ba055695c9a2c4b6b6fd"
    },
    {
      "name": "broken metadata passes through lowercased",
      "repo_url": "Not A URL",
      "finding": {
        "cwes": [
          "CWE-522"
        ],
        "locations": [
          {
            "path": "x.py"
          }
        ]
      },
      "payload": "not a url|x.py|CWE-522",
      "expected": "93d383bac8ccaf5eb82781be50fc9cef41aa315f95ae1072b875c8012a630a2f"
    }
  ]
}
